# ==========================================
# SmartJob V2 — Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!

# PostgreSQL Database (used when postgres profile is active)
DB_URL=jdbc:postgresql://localhost:5432/smartjob
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-secure-random-secret-key-at-least-32-characters
JWT_EXPIRATION_MS=86400000
